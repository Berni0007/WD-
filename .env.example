# Bothost / Discord
DISCORD_CHANNEL_ID=
# Токен Discord задаётся в поле Bot Token Bothost.
# Для ручного запуска: DISCORD_BOT_TOKEN=

# Steam — нужен для получения актуального lobby ID игрока на сервере
STEAM_API_KEY=
WARDOGS_APP_ID=1867240

# Один сервер ZARUBA
SERVER_1_NAME=ZARUBA
SERVER_1_QUERY=#1 [RU] WARDOGS RUSSIA
SERVER_1_GAME_ID=428424

# Как в исходном проекте: берём SteamID игроков через RCON,
# затем через Steam API получаем текущий lobbysteamid.
SERVER_1_RCON_HOST=
SERVER_1_RCON_PORT=
SERVER_1_RCON_PASSWORD=

# Необязательно: SteamID игроков, которых можно использовать как seed.
# Формат: 7656119xxxxxxxxxx,7656119xxxxxxxxxx
SERVER_1_SEEDS=

# ВАЖНО: IP 51.83.166.16:7778 НЕ используется через steam://connect.
# Подключение идёт только через steam://joinlobby, как в исходном проекте.
